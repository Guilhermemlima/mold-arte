# =============================================================
#  Ligação com o Precifica 3D
#
#  Copie este arquivo para `.env.local` (desenvolvimento) e crie as
#  mesmas variáveis no painel da Vercel (produção).
#
#  Sem elas o site funciona igual, só que mostrando o catálogo de
#  demonstração em vez dos seus produtos.
# =============================================================

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API → Project API keys → anon / public
#
# Esta chave PODE ficar no site: ela sozinha não abre nada, porque quem
# decide o que é visível são as regras do banco. A outra chave, a
# `service_role`, NUNCA pode vir para cá — ela ignora todas as regras.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
#  Chave privada — SÓ para o servidor criar pedidos
#
#  Project Settings → API → Project API keys → service_role / secret
#
#  ⚠️ Repare que ela NÃO tem o prefixo NEXT_PUBLIC_. Isso não é
#  detalhe: variáveis com esse prefixo são embutidas no site e ficam
#  visíveis para qualquer visitante. Esta chave ignora todas as
#  regras do banco — se ela vazar, a pessoa lê e apaga tudo, inclusive
#  pedidos e dados de clientes.
#
#  Na Vercel, cadastre normalmente em Environment Variables. Nunca
#  cole em componente, em página, nem em arquivo com "use client".
SUPABASE_SERVICE_ROLE_KEY=

# Identificador da sua conta no Supabase. Rode no SQL Editor:
#   select id, email from auth.users;
#
# Serve para a vitrine mostrar só os SEUS produtos, caso outra pessoa
# venha a usar o Precifica no mesmo projeto. Pode ficar em branco.
NEXT_PUBLIC_SUPABASE_OWNER=

# Endereço público do site. Só preencha quando o domínio próprio estiver
# no ar — na Vercel, sem isso, ele usa o domínio gerado automaticamente.
# NEXT_PUBLIC_SITE_URL=https://moldarte3d.com.br
