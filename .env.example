# =============================================================
#  Ligação com o Precifica 3D
#
#  Copie este arquivo para `.env.local` (desenvolvimento) e crie as
#  mesmas variáveis no painel da Vercel (produção).
#
#  Sem elas o site funciona igual, só que mostrando o catálogo de
#  demonstração em vez dos seus produtos.
# =============================================================

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API → Project API keys → anon / public
#
# Esta chave PODE ficar no site: ela sozinha não abre nada, porque quem
# decide o que é visível são as regras do banco. A outra chave, a
# `service_role`, NUNCA pode vir para cá — ela ignora todas as regras.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
#  Chave privada — SÓ para o servidor criar pedidos
#
#  Project Settings → API → Project API keys → service_role / secret
#
#  ⚠️ Repare que ela NÃO tem o prefixo NEXT_PUBLIC_. Isso não é
#  detalhe: variáveis com esse prefixo são embutidas no site e ficam
#  visíveis para qualquer visitante. Esta chave ignora todas as
#  regras do banco — se ela vazar, a pessoa lê e apaga tudo, inclusive
#  pedidos e dados de clientes.
#
#  Na Vercel, cadastre normalmente em Environment Variables. Nunca
#  cole em componente, em página, nem em arquivo com "use client".
SUPABASE_SERVICE_ROLE_KEY=

# Identificador da sua conta no Supabase. Rode no SQL Editor:
#   select id, email from auth.users;
#
# Serve para a vitrine mostrar só os SEUS produtos, caso outra pessoa
# venha a usar o Precifica no mesmo projeto. Pode ficar em branco.
NEXT_PUBLIC_SUPABASE_OWNER=

# ---------------------------------------------------------------
#  Pagamento pelo Asaas
#
#  Painel do Asaas → Integrações → Chave de API (Gerar chave).
#  Sem isto o pedido continua sendo registrado e o estoque
#  reservado — só que o acerto volta a ser combinado por WhatsApp.
#
#  Não leva NEXT_PUBLIC_: dá acesso à sua conta financeira inteira.
ASAAS_API_KEY=

# "sandbox" (padrão) usa o ambiente de testes, com dinheiro de
# mentira — use enquanto estiver experimentando.
# Troque para "producao" quando for cobrar de verdade, e lembre que
# a chave do sandbox NÃO funciona em produção: são chaves diferentes.
ASAAS_AMBIENTE=sandbox

# Invente um texto qualquer e repita ele no Asaas, ao cadastrar o
# webhook, no campo "Token de autenticação". É o que impede alguém
# de fingir ser o Asaas e declarar pedidos como pagos.
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------
#  Aviso de pedido por e-mail
#
#  Crie a conta em https://resend.com (gratuito até 3.000 e-mails
#  por mês), vá em API Keys → Create API Key e cole aqui.
#
#  Sem isto o pedido continua sendo gravado e o estoque reservado —
#  só que ninguém é avisado, e você descobre a venda ao sincronizar
#  o Precifica.
RESEND_API_KEY=

# Para onde vai o aviso de venda nova. Em branco, usa o e-mail que
# está em src/lib/site.ts.
EMAIL_LOJISTA=

# Quem assina o e-mail. Enquanto você não verificar um domínio
# próprio no Resend, deixe em branco: o remetente de teste deles é o
# único permitido, e ele só entrega no e-mail da SUA conta. Ou seja,
# o aviso para você funciona e a confirmação para o cliente não sai.
#
# Depois de registrar o domínio e verificá-lo no Resend, mude para
# algo como: Moldarte 3D <pedidos@moldarte3d.com.br>
EMAIL_REMETENTE=

# ---------------------------------------------------------------
#  Aviso de que o catálogo mudou (opcional, mas recomendado)
#
#  Invente qualquer texto e repita ele no Precifica, em
#  Nuvem → "Avisar a loja na hora" → Chave de atualização.
#
#  Sem isto a loja se atualiza sozinha, só que leva até 30 segundos
#  depois de você publicar. Com isto, o Precifica avisa assim que
#  sincroniza e a mudança aparece quase na hora.
#
#  Também não leva NEXT_PUBLIC_: é só o servidor que confere.
REVALIDATE_SECRET=

# Endereço público do site. Só preencha quando o domínio próprio estiver
# no ar — na Vercel, sem isso, ele usa o domínio gerado automaticamente.
# NEXT_PUBLIC_SITE_URL=https://moldarte3d.com.br
